# Server Configuration
PORT=3000
NODE_ENV=development
API_PASSWORD=your_secure_password_here
# At least 16 characters; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
TOKEN_EXPIRY=24h
# Comma-separated; empty or * allows all
ALLOWED_IPS=127.0.0.1

# Country API credentials (a country stays disabled until its keys are set)
BPS_API_KEY=

# Storage
LOCAL_STORAGE_PATH=./storage/exports
DB_PATH=./storage/ledger.db

# Scheduler: ticks daily and extracts whatever months are due per country
SCHEDULER_CRON=0 3 * * *
# SCHEDULER_TIMEZONE=Asia/Jakarta
SCHEDULER_ENABLED=true
SCHEDULER_RUN_ON_START=false
# How many published months to keep re-checking (covers late releases and downtime)
AUTO_SYNC_LOOKBACK_MONTHS=3
# Auto sync stops retrying a FAILED task after this many consecutive errors
MAX_TASK_ATTEMPTS=5

# Concurrency & retries
MAX_CONCURRENT_EXTRACTIONS=4
MAX_CONCURRENT_PER_COUNTRY=2
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_MS=2000
