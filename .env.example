# Server Configuration
PORT=3000
NODE_ENV=development
# Comma-separated; empty or * allows all
ALLOWED_IPS=127.0.0.1

# Supabase: Project Settings > API. Run supabase/schema.sql in the SQL editor once.
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key: server only, never put it in the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Private Storage bucket for extracted files (created on first start; the web app reads it)
SUPABASE_BUCKET=trade-exports
# A month's CSV larger than this (MB) is split into _part1.csv, _part2.csv…; keep it under your plan's upload limit (50 MB on Free)
MAX_UPLOAD_MB=40

# Country API credentials (a country stays disabled until its keys are set)
BPS_API_KEY=
# Japan: e-Stat application ID (free, https://www.e-stat.go.jp/api/)
ESTAT_APP_ID=

# A run flags this many requests in a row that return 0 records (no data there, or the
# source may be restricting requests), then carries on
EMPTY_STREAK_FLAG_AT=300

# Concurrency & retries
MAX_CONCURRENT_EXTRACTIONS=4
MAX_CONCURRENT_PER_COUNTRY=2
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_MS=2000
